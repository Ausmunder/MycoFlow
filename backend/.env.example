# Database Configuration
# SQLite (default for development)
DATABASE_URL=sqlite:///./sopp_tracker.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/sopp_tracker

# Or use Railway/Render PostgreSQL URL
# DATABASE_URL=postgresql://...

# MQTT for Home Assistant (optional)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=sopp_tracker

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
